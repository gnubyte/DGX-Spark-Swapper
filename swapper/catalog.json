  "snippets": {
    "LAGUNA_BOOTSTRAP": [
      "set -e",
      "export PATH=/usr/local/cuda/bin:$PATH",
      "FLASHINFER_VERSION=0.6.15.dev20260712",
      "INSTALLED=\"$(python3 -c 'import flashinfer; print(flashinfer.__version__)' 2>/dev/null || true)\"",
      "if [[ \"${INSTALLED}\" == \"${FLASHINFER_VERSION}\" ]]; then",
      "  echo \"[bootstrap] FlashInfer ${FLASHINFER_VERSION} already installed\"",
      "else",
      "  echo \"[bootstrap] Installing FlashInfer ${FLASHINFER_VERSION} for FP4 support (found: ${INSTALLED:-none}) ...\"",
      "  pip install --upgrade --no-deps \"flashinfer-python==${FLASHINFER_VERSION}\" \"flashinfer-cubin==${FLASHINFER_VERSION}\" \"flashinfer-jit-cache==${FLASHINFER_VERSION}+cu130\" --extra-index-url https://flashinfer.ai/whl/nightly/ --extra-index-url https://flashinfer.ai/whl/nightly/cu130/ \\",
      "    && pip install --upgrade \"cuda-tile==1.5.0\" \"nccl4py==0.3.1\" \\",
      "    && echo \"[bootstrap] Installed flashinfer ${FLASHINFER_VERSION}\" \\",
      "    || { echo \"[bootstrap] FATAL: flashinfer ${FLASHINFER_VERSION} install failed; refusing to start with mismatched FP4 kernels\"; exit 1; }",
      "fi",
      "echo \"[bootstrap] Starting vLLM ...\"",
      "exec vllm serve \"$@\""
    ],
    "TABBY_ENTRYPOINT": [
      "set -e",
      "cd /opt/tabbyAPI",
      "SNAP=$(ls -dt /model/snapshots/*/ 2>/dev/null | head -n1)",
      "[ -n \"$SNAP\" ] || { echo \"no model snapshot under /model/snapshots\" >&2; exit 1; }",
      "mkdir -p /srv/models",
      "ln -sfn \"${SNAP%/}\" \"/srv/models/$TABBY_NAME\"",
      "printf \"api_key: '%s'\\nadmin_key: '%s'\\n\" \"$TABBY_API_KEY\" \"$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')\" > api_tokens.yml",
      "cat > config.yml <<EOF",
      "network:",
      "  host: 127.0.0.1",
      "  port: $TABBY_PORT",
      "  disable_auth: false",
      "  api_servers: [\"OAI\"]",
      "model:",
      "  model_dir: /srv/models",
      "  model_name: $TABBY_NAME",
      "  backend: exllamav3",
      "  max_seq_len: $TABBY_CTX",
      "  cache_mode: FP16",
      "EOF",
      "exec python3 main.py"
    ]
  },

  "builds": {
    "tabby-exl3": {
      "image": "swapper/tabbyapi-exl3:1.6.3-a270c55",
      "free_gb": 40,
      "mem_gb": 24,
      "args": { "EXLLAMAV3_REF": "v1.6.3", "TABBY_REF": "a270c555db91a5178d72f7dee7bdd34951ac1dad", "MAX_JOBS": "6" },
      "dockerfile": [
        "FROM nvcr.io/nvidia/pytorch:26.07-py3",
        "ARG EXLLAMAV3_REF",
        "ARG TABBY_REF",
        "ARG MAX_JOBS=6",
        "ENV TORCH_CUDA_ARCH_LIST=\"12.1\" MAX_JOBS=${MAX_JOBS} PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1",
        "RUN pip install --upgrade \"setuptools>=77\" wheel ninja",
        "RUN git clone https://github.com/turboderp-org/exllamav3 /opt/exllamav3 \\",
        " && git -C /opt/exllamav3 checkout \"$EXLLAMAV3_REF\" \\",
        " && cd /opt/exllamav3 && pip install --no-build-isolation .",
        "RUN pip install \"flash-linear-attention>=0.5.0\"",
        "RUN git clone https://github.com/theroyallab/tabbyAPI /opt/tabbyAPI \\",
        " && git -C /opt/tabbyAPI checkout \"$TABBY_REF\" \\",
        " && pip install \"fastapi-slim>=0.115\" \"pydantic>=2.11,<3\" ruamel.yaml rich \"uvicorn>=0.28.1\" \"jinja2>=3.0.0\" loguru \"sse-starlette>=2.2.0\" packaging \"tokenizers>=0.21.0\" numpy aiofiles aiohttp async_lru huggingface_hub psutil \"httptools>=0.5.0\" pillow requests",
        "WORKDIR /opt/tabbyAPI"
      ]
    }
  },

