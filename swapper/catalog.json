          "--security-opt", "seccomp=unconfined", "--security-opt", "apparmor=unconfined",
          "--restart", "unless-stopped",
          "-e", "HF_HOME=/root/.cache/huggingface", "-e", "HF_HUB_OFFLINE=1",
          "-e", "CUTE_DSL_ARCH=sm_121a", "-e", "VLLM_WORKER_MULTIPROC_METHOD=spawn",
          "-v", "{{HOME}}/.cache/huggingface:/root/.cache/huggingface",
          "-v", "{{HOME}}/.cache/vllm:/root/.cache/vllm",
          "-v", "{{HOME}}/.cache/flashinfer:/root/.cache/flashinfer",
          "-v", "{{HOME}}/.triton:/root/.triton",
          "--entrypoint", "bash", "eugr/spark-vllm-b12x:nightly-20261015", "-c", "exec vllm serve \"$@\"", "vllm-serve",
          "{{REPO}}", "--revision", "{{COMMIT}}",
          "--host", "127.0.0.1", "--port", "{{API_PORT}}", "--api-key", "{{API_KEY}}",
          "--served-model-name", "{{SLUG}}",
          "--tensor-parallel-size", "1", "--max-model-len", "{{CTX}}", "--gpu-memory-utilization", "{{UTIL}}",
          "--enable-prefix-caching", "--enable-chunked-prefill", "--max-num-seqs", "8"
        ]
      }
    },

    "exllamav3": {
      "label": "ExLlamaV3 · TabbyAPI",
      "platforms": ["nvidia-gb10"],
      "formats": ["exl3"],
      "engine": "ExLlamaV3 · TabbyAPI",
      "vision": false,
      "image_gb": 25,
      "build": true,
      "entry": {
        "platforms": ["nvidia-gb10"],
        "kind": "docker",
        "container": "swapper-{{KEY}}",
        "template_kwargs": false,
        "start_timeout_s": 1800,
        "eta": "a few minutes (loads the weights into memory)",
        "install": {
          "requires": ["docker"],
          "steps": [
            { "do": "docker_build", "build": "tabby-exl3" },
            { "do": "hf_snapshot", "repo": "{{REPO}}", "revision": "{{COMMIT}}" }
          ],
          "ready": [
            { "docker_image_or_container": "swapper/tabbyapi-exl3:1.6.3-a270c55", "container": "swapper-{{KEY}}" },
            { "hf_snapshot": "{{REPO}}", "revision": "{{COMMIT}}" }
          ]
        },
        "footprint": { "shared_images": ["nvcr.io/nvidia/pytorch:26.07-py3"] },
        "docker_run": [
          "--network", "host", "--ipc", "host", "--shm-size", "16g", "--gpus", "all",
          "--ulimit", "memlock=-1", "--restart", "unless-stopped",
          "-e", "TABBY_API_KEY={{API_KEY}}", "-e", "TABBY_PORT={{API_PORT}}", "-e", "TABBY_CTX={{CTX}}",
          "-e", "TABBY_NAME={{SLUG}}",
          "-v", "{{HOME}}/.cache/huggingface/hub/models--{{REPO_DIR}}:/model:ro",
          "--entrypoint", "bash", "swapper/tabbyapi-exl3:1.6.3-a270c55", "-c", "{{TABBY_ENTRYPOINT}}"
        ]
      }
    },

    "llamacpp-gguf": {
      "label": "llama.cpp (Vulkan)",
      "platforms": ["amd-strix-halo"],
      "formats": ["gguf"],
      "engine": "llama.cpp · Vulkan",
      "vision": false,
      "image_gb": 0,
      "entry": {
        "platforms": ["amd-strix-halo"],
        "kind": "llamacpp",
        "unit": "swapper-llama-{{KEY}}",
        "args": [
          "--ctx-size", "{{CTX}}", "--n-gpu-layers", "999", "--parallel", "1", "--threads", "12",
          "--batch-size", "512", "--ubatch-size", "512", "--flash-attn", "on", "--kv-unified", "--no-mmap", "--jinja"
        ],
        "start_timeout_s": 900,
        "eta": "a minute or so",
        "install": {
          "requires": ["vulkan", "llamacpp"],
          "steps": [ { "do": "hf_files" } ],
          "ready": [ { "hf_files": true } ]
        }
      }
    }
  }
}
