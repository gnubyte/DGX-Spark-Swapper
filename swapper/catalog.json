      "context": 262144,
      "vision": false,
      "min_free_gib": 108,
      "start_timeout_s": 2400,
      "eta": "about 15 minutes the first time (kernel compilation); faster after",
      "openclaw_provider": "laguna",
      "openclaw_model_name": "Laguna S 2.1 NVFP4 (vLLM, DFlash, 256K ctx)",
      "openclaw_context": 262144,
      "perf": {
        "decode": 76.7, "decode_concurrent": 139.6, "concurrency": 4,
        "source": "the recipe's own benchmark chart: 76.7 tok/s for one request, 34.9 each with 4 at once", "estimate": false
      },
      "repo": "https://github.com/MiaAI-Lab/Laguna-S-2.1-DGX-Spark-RTX-6000-PRO",
      "notes": [
        "The recipe's limit of 4 requests at once is deliberate: DFlash crashes at vLLM's default of 256.",
        "The first start installs matching FlashInfer kernels from flashinfer.ai, so the box needs internet then."
      ],
      "install": {
        "requires": ["docker"],
        "size_gb": 125,
        "time": "1–2 hours: pulls the vLLM image and downloads ~100 GB of weights",
        "note": "Needs about 125 GB of free disk. Weights go to the Hugging Face cache, shared with the recipes.",
        "steps": [
          { "do": "mkdirs", "paths": ["{{HOME}}/.cache/huggingface", "{{HOME}}/.cache/flashinfer"] },
          { "do": "docker_pull", "image": "vllm/vllm-openai:v0.25.1", "timeout": 7200 },
          { "do": "hf_snapshot", "repo": "poolside/Laguna-S-2.1-NVFP4" },
          { "do": "hf_snapshot", "repo": "poolside/Laguna-S-2.1-DFlash-NVFP4" }
        ],
        "ready": [
          { "docker_image_or_container": "vllm/vllm-openai:v0.25.1", "container": "laguna-s-2.1-nvfp4" },
          { "hf_snapshot": "poolside/Laguna-S-2.1-NVFP4" },
          { "hf_snapshot": "poolside/Laguna-S-2.1-DFlash-NVFP4" }
        ]
      },
      "footprint": { "dirs": ["{{HOME}}/.cache/flashinfer"] },
      "docker_run": [
        "--network", "host", "--ipc", "host", "--shm-size", "32g", "--gpus", "all",
        "--ulimit", "memlock=-1:-1", "--cap-add", "IPC_LOCK", "--user", "root",
        "--restart", "unless-stopped",
        "-e", "VLLM_TARGET_DEVICE=cuda", "-e", "VLLM_TRUST_REMOTE_CODE=1", "-e", "CUTE_DSL_ARCH=sm_121a",
        "-e", "MAX_JOBS=4", "-e", "NVCC_THREADS=2", "-e", "FLASHINFER_NVCC_THREADS=2",
        "-e", "HF_HOME=/root/.cache/huggingface", "-e", "HF_HUB_OFFLINE=1",
        "-v", "{{HOME}}/.cache/huggingface:/root/.cache/huggingface",
        "-v", "{{HOME}}/.cache/flashinfer:/root/.cache/flashinfer",
        "--entrypoint", "bash", "vllm/vllm-openai:v0.25.1", "-c", "{{LAGUNA_BOOTSTRAP}}", "laguna",
        "poolside/Laguna-S-2.1-NVFP4",
        "--host", "127.0.0.1", "--port", "{{API_PORT}}", "--api-key", "{{API_KEY}}",
        "--served-model-name", "laguna-s-2.1",
        "--tensor-parallel-size", "1", "--dtype", "bfloat16", "--attention-backend", "FLASHINFER",
        "--trust-remote-code", "--gpu-memory-utilization", "0.85", "--max-model-len", "262144",
        "--max-num-seqs", "4", "--max-num-batched-tokens", "8192",
        "--enable-auto-tool-choice", "--tool-call-parser", "poolside_v1", "--reasoning-parser", "poolside_v1",
        "--default-chat-template-kwargs", "{\"enable_thinking\":true}",
        "--override-generation-config", "{\"temperature\":0.7,\"top_p\":0.95,\"top_k\":20}",
        "--speculative-config", "{\"model\":\"poolside/Laguna-S-2.1-DFlash-NVFP4\",\"num_speculative_tokens\":7,\"method\":\"dflash\"}"
      ]
    },

